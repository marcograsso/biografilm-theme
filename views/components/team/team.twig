<section class="border-stroke w-full {{ component.show_border_top ? "border-t" : "" }} {{ component.show_border_bottom ? "border-b" : "" }}">
  {% if component.title %}
    {% set title_class = component.title_style == "display"
      ? "display-h3"
      : "heading-h4 font-semibold"
    %}
    <div class="px-6 pt-20 pb-10 xl:px-10 xl:pt-10 xl:pb-10">
      <h2 class="{{ title_class }}">{{ component.title }}</h2>
    </div>
  {% endif %}
  {% if component.members %}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {% for member in component.members %}
        {{
          include(
            "components/giurie/member-card.twig",
            { member: member, is_last: loop.last }
          )
        }}
      {% endfor %}
    </div>
  {% endif %}
</section>
