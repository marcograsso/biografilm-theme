{% extends "base.twig" %}

{% block hero %}
  <div class="mt-[108px] w-full px-6 py-20 xl:px-10 xl:py-20">
    <div class="flex flex-col gap-6 xl:w-2/3">
      {{ include("parts/breadcrumbs.twig") }}
      <h1 class="display-h1-news">{{ post.title }}</h1>
      {% set doc = function("get_field", "attivita_doc", post.ID) %}
      {% if doc.sottotitolo %}
        <p class="text-sm">
          {{ doc.sottotitolo }}
        </p>
      {% endif %}
    </div>
  </div>
{% endblock hero %}

{% block content %}
  <article class="mb-10">
    <div class="flex flex-col gap-10 xl:w-2/3 xl:gap-12">
      {% if post.thumbnail %}
        {% set thumb_id = function("get_post_thumbnail_id", post.ID) %}
        {% set fp = thumb_id
          ? function("get_post_meta", thumb_id, "focalpoint", true)
          : null
        %}
        {% set fp_style = fp
          ? "object-position: " ~ ((fp.left * 100)|round) ~ "% "
            ~ ((fp.top * 100)|round)
            ~ "%;"
          : null
        %}
        <div class="aspect-video w-full overflow-hidden">
          <img
            src="{{ post.thumbnail.src("large") }}"
            alt="{{ post.thumbnail.alt }}"
            class="h-full w-full object-cover xl:pb-8"
            style="{{ fp_style }}"
          />
        </div>
      {% endif %}

      <div
        class="prose-content prose border-stroke max-w-none px-6 text-xl leading-[150%] text-black/80 xl:px-10"
      >
        {{ post.content }}
      </div>

      {{ include("parts/approfondimenti.twig") }}
    </div>
  </article>
{% endblock content %}
